<?php

declare(strict_types=1);

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Extension\ExtensionPathResolver;

/**
 * Helper to resolve template path.
 */
function _bm_aggrid_template_path(): string {
  static $path;
  if (!isset($path)) {
    $pathResolver = \Drupal::service('extension.path.resolver');
    $path = $pathResolver->getPath('module', 'bm_aggrid') . '/templates';
  }
  return $path;
}

/**
 * Implements hook_help().
 */
function bm_aggrid_help($route_name, RouteMatchInterface $route_match): string {
  if ($route_name === 'help.page.bm_aggrid') {
    return t('AG Grid Display exposes configurable, AG Grid powered listings for Drupal entities. Configure displays at <code>/admin/config/content/aggrid-display</code>.');
  }
  return '';
}

/**
 * Implements hook_theme().
 */
function bm_aggrid_theme($existing, $type, $theme, $path) {
  $base = _bm_aggrid_template_path();
  return [
    'bm_aggrid_grid' => [
      'variables' => [
        'grid_id' => NULL,
        'configuration' => NULL,
      ],
      'path' => $base,
      'template' => 'aggrid-display-grid',
    ],
    'bm_aggrid_wrapper' => [
      'variables' => ['content' => NULL],
      'path' => $base,
      'template' => 'aggrid-display-wrapper',
    ],
  ];
}
