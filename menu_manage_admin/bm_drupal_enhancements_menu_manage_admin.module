<?php

declare(strict_types=1);

use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_form_FORM_ID_alter() for menu_overview_form.
 */
function bm_drupal_enhancements_menu_manage_admin_form_menu_overview_form_alter(array &$form, FormStateInterface $form_state): void {
  _bm_dema_menu_controls($form);
}

/**
 * Implements hook_form_FORM_ID_alter() for menu_edit_form.
 */
function bm_drupal_enhancements_menu_manage_admin_form_menu_edit_form_alter(array &$form, FormStateInterface $form_state): void {
  _bm_dema_menu_controls($form);
}

/**
 * Adds controls and attaches library for menu overview UX.
 */
function _bm_dema_menu_controls(array &$form): void {
  $form['#attached']['library'][] = 'bm_drupal_enhancements_menu_manage_admin/menu_overview_enhance';
  $form['#attached']['drupalSettings']['bm_menu_manage_admin']['version'] = '1.1.1';

  if (!isset($form['bm_menu_manage_controls'])) {
    $form['bm_menu_manage_controls'] = [
      '#type' => 'fieldset',
      '#title' => t('Menu controls'),
      '#weight' => isset($form['links']['#weight']) ? ((float) $form['links']['#weight'] - 0.005) : 0.0035,
      '#attributes' => ['class' => ['bm-menu-manage-controls']],
      'actions' => [
        '#type' => 'container',
        '#attributes' => ['class' => ['bm-menu-manage-buttons']],
        'expand_all' => [
          '#type' => 'button',
          '#value' => t('Expand all (+)'),
          '#attributes' => [
            'class' => ['bm-menu-expand-all', 'button', 'button--secondary'],
            'data-bm-menu-action' => 'expand-all',
          ],
        ],
        'collapse_level_1' => [
          '#type' => 'button',
          '#value' => t('Collapse level 1'),
          '#attributes' => [
            'class' => ['bm-menu-collapse-level', 'button', 'button--secondary'],
            'data-bm-menu-action' => 'collapse-level-1',
            'data-bm-menu-level' => '1',
          ],
        ],
        'collapse_level_2' => [
          '#type' => 'button',
          '#value' => t('Collapse level 2'),
          '#attributes' => [
            'class' => ['bm-menu-collapse-level', 'button', 'button--secondary'],
            'data-bm-menu-action' => 'collapse-level-2',
            'data-bm-menu-level' => '2',
          ],
        ],
        'collapse_level_3' => [
          '#type' => 'button',
          '#value' => t('Collapse level 3'),
          '#attributes' => [
            'class' => ['bm-menu-collapse-level', 'button', 'button--secondary'],
            'data-bm-menu-action' => 'collapse-level-3',
            'data-bm-menu-level' => '3',
          ],
        ],
        'collapse_level_4' => [
          '#type' => 'button',
          '#value' => t('Collapse level 4'),
          '#attributes' => [
            'class' => ['bm-menu-collapse-level', 'button', 'button--secondary'],
            'data-bm-menu-action' => 'collapse-level-4',
            'data-bm-menu-level' => '4',
          ],
        ],
      ],
      'counts' => [
        '#type' => 'container',
        '#attributes' => ['class' => ['bm-menu-counts']],
        'total' => [
          '#markup' => t('Total: <strong class="bm-menu-count-total"></strong>'),
        ],
        'visible' => [
          '#markup' => t('Visible: <strong class="bm-menu-count-visible"></strong>'),
        ],
      ],
      'filter' => [
        '#type' => 'textfield',
        '#title' => t('Quick filter'),
        '#title_display' => 'invisible',
        '#attributes' => [
          'placeholder' => t('Filter menu items...'),
          'class' => ['bm-menu-filter'],
          'autocomplete' => 'off',
        ],
        '#description' => t('Filter by label. Matching items stay visible; ancestors of matches remain open.'),
      ],
      'filter_secondary' => [
        '#type' => 'textfield',
        '#title' => t('Quick filter (target)'),
        '#title_display' => 'invisible',
        '#attributes' => [
          'placeholder' => t('Filter target items...'),
          'class' => ['bm-menu-filter', 'bm-menu-filter-secondary'],
          'autocomplete' => 'off',
        ],
        '#description' => t('Use both filters to keep sources and targets visible for drag/drop.'),
      ],
    ];
  }
}
