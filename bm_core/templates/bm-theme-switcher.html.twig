{# bm_core/templates/bm-theme-switcher.html.twig #}
<div data-bm-theme-switcher class="bm-theme-switcher">
  <button type="button" class="button" data-theme="light">{{ 'Light'|t }}</button>
  <button type="button" class="button" data-theme="dark">{{ 'Dark'|t }}</button>
  <button type="button" class="button" data-theme="system">{{ 'System'|t }}</button>
</div>
